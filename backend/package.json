{
  "name": "@sitecraft/api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-advanced.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "verify": "node scripts/verify.mjs",
    "db:seed:advanced": "tsx prisma/seed-advanced.ts",
    "db:seed:verify": "node scripts/verify-seed.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "cookie-parser": "^1.4.7",
    "deepmerge-ts": "^8.0.2",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "multer": "^2.5.0",
    "deepmerge-ts": "^8.0.2"
  }
}
