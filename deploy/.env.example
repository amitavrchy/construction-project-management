# Runtime environment for Sitecraft -> copy to /opt/apps/sitecraft/.env on the server
# (chmod 600). Never commit the real file. Generate secrets with: openssl rand -hex 32
# Avoid "$" in values: docker compose interpolates them.

# ---- Backend (required) ----
# Shared Postgres 16 container on the apps-net network; database + user "sitecraft".
DATABASE_URL=postgresql://sitecraft:CHANGE_ME_DB_PASSWORD@shared-postgres:5432/sitecraft?schema=public
# Signs session cookies (HS256). >= 32 random chars, must not start with "replace-". GENERATE.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Public frontend URL.
APP_URL=https://sitecraft.13.203.3.1.sslip.io
# Comma-separated origins allowed for CORS and for state-changing requests (POST/PUT/PATCH/DELETE).
CORS_ORIGINS=https://sitecraft.13.203.3.1.sslip.io

# ---- Backend (optional) ----
# Redis enables response caching and the BullMQ daily digest / monthly payroll job.
# Leave empty to run without Redis (cache + scheduled jobs are skipped; app works).
REDIS_URL=
# Initial password for the seeded demo users (admin@..., pm@..., etc.), >= 12 chars.
# Only needed when running the seed command. GENERATE / choose.
SEED_PASSWORD=
# Business rules (defaults shown; basis points / minor currency units).
VARIANCE_ALERT_BPS=1000
OT_MULTIPLIER_BPS=15000
REQUISITION_APPROVAL_LIMIT_MINOR=10000000
BILL_APPROVAL_LIMIT_MINOR=100000000

# PORT / NODE_ENV are set by docker-compose.yml (container port 4000 -> host 127.0.0.1:4001).

# ---- Frontend ----
# No runtime variables. The frontend calls same-origin /api/* and Next.js proxies it to
# API_URL, which is baked at image build time (GitHub Actions) as http://sitecraft-backend:4000.
